+            widget = QtWidgets.QWidget.find(mxs.windows.getMAXHWND())
+            return shiboken.wrapInstance(shiboken.getCppPointer(widget)[0], QtWidgets.QMainWindow)
     else:
         import MaxPlus
         if version > 2017:
